    <!-- keymaster
         BlueStacks: 注释掉主 manifest 里的 keymaster 声明，仅保留 fragment
         `android.hardware.keymaster@4.1-service.xml` 的声明。
         原因：A16 libvintf 对 mainifest 与 fragment 重复声明同一 FqInstance
         (@4.1::IKeymasterDevice/default) 变严，会抛 VINTF parse error →
         整个 manifest 解析失败 → 所有依赖 VINTF 校验的 HAL 服务（含 keymint）
         addService 时 status=-3 abort。
         A13 libvintf 容忍重复声明所以没事。
         详见 A16-init-bringup-notes.md 第 7k 节。
    <hal format="hidl">
       <name>android.hardware.keymaster</name>
       <transport>hwbinder</transport>
       <fqname>@4.0::IKeymasterDevice/default</fqname>
       <fqname>@4.1::IKeymasterDevice/default</fqname>
    </hal>
    -->
</manifest>
